# P0 demo: capture -> one pad -> tempo-synced roll with a rate ramp -> SVF -> out.
# Render with:
#   engine/build/nekta_render engine/examples/jungle_roll.nks -o roll.wav
# The sample is generated by engine/examples/make_demo_wav.py.

samplerate 48000
bpm 174
beatsperbar 4
length 16                 # 4 bars

sample 0 engine/examples/break.wav

# One-shot pad, hard-choked so rolls never pile voices up.
pad 0 sample 0 choke 1 gain 0.9 attack 0 decay 0 sustain 1 release 3

# The headline gesture: 1/8 accelerating to 1/32 over one bar, exponentially,
# with the repeats ducking and the stereo image alternating.
roll pad 0 rate 1/8 to 1/32 over 4 curve exp gate 0.75 decay 0.94 pan 0.4 pitch 0.5 wrap 8

# Rolls launch on the next sixteenth.
quantise 1/16

param fx.1.cutoff 18000
param fx.1.res 0.35
param master.gain 0.9

@0     trigger 0 1.0
@2     trigger 0 0.9
@4     rollstart
@6     param fx.1.cutoff 2500
@7     param fx.1.cutoff 700
@8     rollstop
@8     param fx.1.cutoff 18000
@8     trigger 0 1.0
@10    rollstart
@12    param fx.1.morph 2.0
@12    param fx.1.cutoff 400
@14    rollstop
@14    param fx.1.morph 0.0
@14    param fx.1.cutoff 18000
@14    trigger 0 1.0
